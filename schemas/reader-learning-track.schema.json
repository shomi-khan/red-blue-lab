{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Red Blue Lab Reader Learning Track",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "track_id",
    "reader_id",
    "title",
    "created_at",
    "updated_at",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "track_id": {
      "type": "string",
      "minLength": 1
    },
    "reader_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "learning_node_id",
          "position",
          "status",
          "added_at"
        ],
        "properties": {
          "learning_node_id": {
            "type": "string",
            "minLength": 1
          },
          "position": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
            "enum": [
              "planned",
              "in_progress",
              "completed",
              "skipped"
            ]
          },
          "added_at": {
            "type": "string",
            "format": "date-time"
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_position": {
            "type": "string"
          }
        }
      }
    }
  }
}
